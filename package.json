{
  "name": "@wacry/codeks-bridge",
  "version": "0.0.23",
  "description": "Configurable local Responses API bridge for codeks with GPT, Claude Messages, DeepSeek Chat, and native Gemini adapters.",
  "license": "Apache-2.0",
  "author": "David Zhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WAcry/codeks-bridge.git"
  },
  "type": "module",
  "bin": {
    "codeks-bridge": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "catalog",
    "docs",
    "examples",
    "ui",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "node scripts/check.ts",
    "dev": "node src/cli.ts serve"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
